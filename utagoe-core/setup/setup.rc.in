// 配布用 setup の resource。icon、manifest、版情報、圧縮した Utagoe 本体。CMake が path を埋める。
#include <windows.h>
#include "@UTAGOE_SETUP_IDS@"

IDI_APP ICON "@UTAGOE_SETUP_ICON@"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@UTAGOE_SETUP_MANIFEST@"
IDR_PAYLOAD RCDATA "@UTAGOE_SETUP_PACKED@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @UTAGOE_VERSION_MAJOR@,@UTAGOE_VERSION_MINOR@,0,0
PRODUCTVERSION @UTAGOE_VERSION_MAJOR@,@UTAGOE_VERSION_MINOR@,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "teacommontea"
      VALUE "FileDescription", "Utagoe Setup"
      VALUE "FileVersion", "@UTAGOE_VERSION@"
      VALUE "ProductName", "Utagoe"
      VALUE "ProductVersion", "@UTAGOE_VERSION@"
      VALUE "OriginalFilename", "Utagoe.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
